# make-tasks/Makefile.docker

# If your override stays under docker/llm/scripts, keep this:
COMPOSE_FILES := -f ../docker-compose.yaml -f ../docker/llm/docker-compose.llm.override.yml

# If you move it to repo root as docker-compose.override.yml, then use:
# COMPOSE_FILES := -f ../docker-compose.yaml -f ../docker-compose.override.yml

SHELL := /bin/bash
.DEFAULT_GOAL := help

.PHONY: help llm-mcpo-build llm-mcpo-up llm-mcpo-down llm-mcpo-logs \
        curl-health curl-mcpo-openapi curl-mcpo-docs \
        curl-crawl4ai-openapi curl-crawl4ai-docs curl-scrape clean-all

help: ## Show help
	@grep -E '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | sed -e 's/:.*##/: /' | column -t -s':'

llm-mcpo-build: ## Build images
	docker compose $(COMPOSE_FILES) build

llm-mcpo-up: ## Start stack (detached)
	docker compose $(COMPOSE_FILES) up -d --build

llm-mcpo-down: ## Stop stack
	docker compose $(COMPOSE_FILES) down

llm-mcpo-logs: ## Tail logs
	docker compose $(COMPOSE_FILES) logs -f

curl-health: ## SSE smoke (Crawl4AI)
	curl -sS -N -H 'Accept: text/event-stream' http://localhost:8081/mcp/sse || true

# MCPO (now served under /mcpo/*)
curl-mcpo-openapi: ## MCPO tool OpenAPI (crawl4ai via MCPO)
	curl -sS http://localhost:8081/mcpo/crawl4ai/openapi.json | jq

curl-mcpo-docs: ## MCPO tool docs (HTML)
	curl -sS -I http://localhost:8081/mcpo/crawl4ai/docs

# Crawl4AI REST schema & UI (direct)
curl-crawl4ai-openapi: ## Crawl4AI JSON schema (served at /schema)
	curl -sS http://localhost:8081/crawl4ai/schema | jq

curl-crawl4ai-docs: ## Crawl4AI Playground
	curl -sS -I http://localhost:8081/crawl4ai/docs

curl-scrape: ## POST /api/v1/scrape -> /crawl
	curl -sS http://localhost:8081/api/v1/scrape \
	  -H 'Content-Type: application/json' \
	  -d '{"urls":["https://httpbin.org/html"],"browser_config":{"type":"BrowserConfig","params":{"headless":true}},"crawler_config":{"type":"CrawlerRunConfig","params":{"stream":false,"cache_mode":"bypass"}}}' | jq

clean-all: llm-mcpo-down ## Prune docker artifacts
	docker system prune -f

