# make-tasks/Makefile.llm

SHELL := /bin/bash
COMPOSE_LLM := -f ../docker-compose.llm.yml

.PHONY: llm-up llm-down llm-logs

llm-up: ## 🧠 Start the LLM stack (Ollama, LiteLLM, MCPO)
	@docker compose $(COMPOSE_LLM) up -d --build

llm-down: ## 🧠 Stop the LLM stack
	@docker compose $(COMPOSE_LLM) down

llm-logs: ## 🧠 View logs for the LLM stack
	@docker compose $(COMPOSE_LLM) logs -f
